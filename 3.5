}


Status read_console_line(char *buf, size_t cap, size_t *out_len){
    if (buf == NULL || cap == 0 || out_len == NULL) return ST_ERR_ARG;

    if (fgets(buf, (int)cap, stdin) == NULL) return ST_ERR_INPUT;
    size_t len = strlen(buf);
    while (len > 0 && (buf[len-1] == '\n' || buf[len-1] == '\r')) {
        buf[--len] = '\0';
    }
    *out_len = len;
    return ST_OK;
}

Status parse_uint_str(const char *s, unsigned int *out)
{
    if (s == NULL || out == NULL) return ST_ERR_ARG;
    if (*s == '\0') return ST_ERR_INPUT;
    unsigned long long acc = 0;
    for (const char *p = s; *p != '\0'; ++p) {
        if (!is_digit(*p)) return ST_ERR_INPUT;
        acc = acc * 10ULL + (unsigned long long)(*p - '0');
        if (acc > (unsigned long long)UINT_MAX) return ST_ERR_RANGE;
    }
    *out = (unsigned int)acc;
    return ST_OK;
}

int paths_equal(const char *a, const char *b){
    if (a == NULL || b == NULL) return 0;
    return strcmp(a, b) == 0;
}

int main(int argc, char **argv)
{
    if (argc != 2) {
        fprintf(stderr, "Использование: %s <файл_со_студентами>\n", argv[0]);
        return EXIT_FAILURE;
    }

    Student *arr = NULL;
    size_t n = 0;
    Status st = read_students(argv[1], &arr, &n);
    if (st != ST_OK) { print_status(st); free_students(arr, n); return EXIT_FAILURE; }

    printf("Загружено студентов: %zu\n", n);

    char line[256];
    size_t len = 0;
    int running = 1;

    while (running) {
        print_menu();
        st = read_console_line(line, sizeof line, &len);
        if (st != ST_OK) { print_status(st); break; }
        if (len == 0) continue;

        unsigned int choice = 0;
        st = parse_uint_str(line, &choice);
        if (st != ST_OK) {
            printf("Неизвестный пункт меню\n");
            continue;
        }

        switch (choice) {
        case 0:
            running = 0;
            break;

        case 1: {
            printf("Введите id: ");
            st = read_console_line(line, sizeof line, &len);
            if (st != ST_OK) { print_status(st); break; }
            unsigned int id = 0;
            st = parse_uint_str(line, &id);
            if (st != ST_OK) { print_status(st); break; }
            search_by_id(arr, n, id);
            break;
        }

        case 2: {
            printf("Введите фамилию: ");
            st = read_console_line(line, sizeof line, &len);
            if (st != ST_OK) { print_status(st); break; }
            search_by_surname(arr, n, line);
            break;
        }

        case 3: {
            printf("Введите имя: ");
            st = read_console_line(line, sizeof line, &len);
            if (st != ST_OK) { print_status(st); break; }
            search_by_name(arr, n, line);
            break;
        }

        case 4: {
            printf("Введите группу: ");
            st = read_console_line(line, sizeof line, &len);
            if (st != ST_OK) { print_status(st); break; }
            search_by_group(arr, n, line);
            break;
        }

        case 5:
            qsort(arr, n, sizeof(Student), cmp_by_id);
            printf("Отсортировано по id\n");
            break;

        case 6:
            qsort(arr, n, sizeof(Student), cmp_by_surname);
            printf("Отсортировано по фамилии\n");
            break;

        case 7:
            qsort(arr, n, sizeof(Student), cmp_by_name);
            printf("Отсортировано по имени\n");
            break;

        case 8:
            qsort(arr, n, sizeof(Student), cmp_by_group);
            printf("Отсортировано по группе\n");
            break;

        case 9: {
            printf("Введите id: ");
            st = read_console_line(line, sizeof line, &len);
            if (st != ST_OK) { print_status(st); break; }
            unsigned int id = 0;
            st = parse_uint_str(line, &id);
            if (st != ST_OK) { print_status(st); break; }

            printf("Введите путь к трассировочному файлу: ");
            char path[256];
            size_t plen = 0;
            st = read_console_line(path, sizeof path, &plen);
            if (st != ST_OK) { print_status(st); break; }

            int same = is_same_file(argv[1], path);
            if (same < 0) { print_status(ST_ERR_FILE_IN); break; }
            if (same == 1) { print_status(ST_ERR_SAME_FILE); break; }

            st = trace_by_id(path, arr, n, id);
            if (st != ST_OK) { print_status(st); break; }
            printf("Записано в %s\n", path);
            break;
        }

        case 10: {
            printf("Введите путь к трассировочному файлу: ");
            char path[256];
            size_t plen = 0;
            st = read_console_line(path, sizeof path, &plen);
            if (st != ST_OK) { print_status(st); break; }

            int same = is_same_file(argv[1], path);
            if (same < 0) { print_status(ST_ERR_FILE_IN); break; }
            if (same == 1) { print_status(ST_ERR_SAME_FILE); break; }

            st = trace_above_avg(path, arr, n);
            if (st != ST_OK) { print_status(st); break; }
            printf("Записано в %s\n", path);
            break;
        }

        case 11:
            for (size_t i = 0; i < n; ++i) print_student(&arr[i]);
            break;

        default:
            printf("Неизвестный пункт меню\n");
            break;
        }
    }
    free_students(arr, n);
    return EXIT_SUCCESS;
}
