#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <math.h>
#include <stdarg.h>
#include <limits.h>

static double f1(double x) { return x * x - 4.0; }
static double f2(double x) { return cos(x) - x; }     


static int is_convex(int n, ...) {
    if (n < 3) return -1;   

    double *xs = (double *)malloc(n * sizeof(double));
    double *ys = (double *)malloc(n * sizeof(double));
    if (xs == NULL || ys == NULL) {
        free(xs); free(ys);
        return -1;
    }

    va_list ap;
    va_start(ap, n);
    for (int i = 0; i < n; ++i) {
        xs[i] = va_arg(ap, double);
        ys[i] = va_arg(ap, double);
    }
    va_end(ap);

    
    int sign = 0;
    const double eps = 1e-9;

    for (int i = 0; i < n; ++i) {
        int j = (i + 1) % n;
        int k = (i + 2) % n;

        double v1x = xs[j] - xs[i];
        double v1y = ys[j] - ys[i];
        double v2x = xs[k] - xs[j];
        double v2y = ys[k] - ys[j];

        double cross = v1x * v2y - v1y * v2x;

        if (fabs(cross) < eps) continue;

        int cur = (cross > 0) ? 1 : -1;
        if (sign == 0) {
            sign = cur;
        } else if (sign != cur) {
            free(xs); free(ys);
            return 0;
        }
    }
    free(xs); free(ys);
    return 1;
}

static double poly_value(double x, int n, ...) {
    va_list ap;
    va_start(ap, n);

    double result = va_arg(ap, double);   
    for (int i = n - 1; i >= 0; --i) {
        double a = va_arg(ap, double);
        result = result * x + a;
    }

    va_end(ap);
    return result;
}

static long parse_in_base(const char *str, int base) {
    if (str == NULL || base < 2 || base > 36) return -1;
    long val = 0;
    for (const char *p = str; *p; ++p) {
        int d;
        if (*p >= '0' && *p <= '9') d = *p - '0';
        else if (*p >= 'a' && *p <= 'z') d = *p - 'a' + 10;
        else if (*p >= 'A' && *p <= 'Z') d = *p - 'A' + 10;
        else return -1;
        if (d >= base) return -1;
        val = val * base + d;
        if (val < 0) return -1;   
    }
    return val;
}

static int is_kaprekar(long N, int base) {
    if (N < 0) return 0;

    long sq = N * N;
    if (N != 0 && sq / N != N) return 0;   
    int digits[64];
    int len = 0;
    long tmp = sq;
    if (tmp == 0) { digits[len++] = 0; }
    while (tmp > 0) {
        digits[len++] = (int)(tmp % base);
        tmp /= base;
    }
    for (int split = 1; split < len; ++split) {
        long left = 0, right = 0;
        long mult = 1;
        for (int i = 0; i < split; ++i) {
            right += digits[i] * mult;
            mult *= base;
        }
        mult = 1;
        for (int i = split; i < len; ++i) {
            left += digits[i] * mult;
            mult *= base;
        }
        if (left + right == N) return 1;
    }
    return 0;
}

static int find_kaprekar(int base, int count, ...) {
    if (base < 2 || base > 36 || count < 0) return -1;

    va_list ap;
    va_start(ap, count);

    int found = 0;
    for (int i = 0; i < count; ++i) {
        const char *str = va_arg(ap, const char *);
        long n = parse_in_base(str, base);
        if (n >= 0 && is_kaprekar(n, base)) {
            printf("  %s (base %d) = %ld — число Капрекара\n", str, base, n);
            ++found;
        }
    }
    va_end(ap);
    return found;
}

static double geometric_mean(int count, ...) {
    if (count <= 0) return NAN;

    va_list ap;
    va_start(ap, count);

    double log_sum = 0.0;
    for (int i = 0; i < count; ++i) {
        double x = va_arg(ap, double);
        if (x <= 0.0) { va_end(ap); return NAN; }  
        log_sum += log(x);
    }
    va_end(ap);

    return exp(log_sum / count);
}

static double fast_pow(double base, int exp) {
    if (exp == 0) return 1.0;

    if (exp < 0) {
        if (exp == INT_MIN) return NAN;
        return 1.0 / fast_pow(base, -exp);
    }

    if (exp % 2 == 0) {
        double half = fast_pow(base, exp / 2);
        return half * half;
    } else {
        return base * fast_pow(base, exp - 1);
    }
}

static double dihotomi(double a, double b, double eps, double (*f)(double)) {
    if (f == NULL) return NAN;
    if (eps <= 0.0) return NAN;

    double fa = f(a);
    double fb = f(b);
    if (fa * fb > 0.0) return NAN;

    while ((b - a) / 2.0 > eps) {
        double c = (a + b) / 2.0;
        double fc = f(c);

        if (fabs(fc) < eps) return c;

        if (fa * fc < 0.0) {
            b = c; fb = fc;
        } else {
            a = c; fa = fc;
        }
    }
    return (a + b) / 2.0;
}

int main(void){
    printf("Квадрат: %d\n", is_convex(4, 0.0,0.0, 1.0,0.0, 1.0,1.0, 0.0,1.0));
    printf("Звезда: %d\n", is_convex(5, 0.0,2.0, 1.0,-1.0, -2.0,1.0, 2.0,1.0, -1.0,-1.0));  

    double v = poly_value(2.0, 3, 2.0, -3.0, 4.0, -5.0);
    printf("P(2) = %.4f\n", v);

    printf("\nДвоичные (base 2):\n");
    find_kaprekar(2, 3, "11", "101", "111");

    printf("Среднее геометрическое(1, 4, 16) = %.4f\n", geometric_mean(3, 1.0, 4.0, 16.0));

    printf("2^10 = %.4f\n", fast_pow(2.0, 10));
    printf("3^0 = %.4f\n", fast_pow(3.0, 0));
    
    printf("x^2 - 4 = 0; x = %.6f\n", dihotomi(0.0, 3.0, 1e-6, f1));
    printf("cos(x) - x = 0; x = %.6f\n", dihotomi(0.0, 1.0, 1e-6, f2));

    return 0;
}
