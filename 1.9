#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <time.h>
#include <limits.h>
#include <math.h>

#define ARR_SIZE 20
#define MIN_SIZE 10
#define MAX_SIZE 10000
#define MIN_VAL  -1000
#define MAX_VAL   1000

 enum Status {
    STATUS_OK = 0,
    STATUS_ERR_ARGC,
    STATUS_ERR_NUMBER_FORMAT,
    STATUS_ERR_RANGE,
    STATUS_ERR_MEMORY
};    

static enum Status parse_long(const char *str, long *out) {
    if (str == NULL || out == NULL) return STATUS_ERR_NUMBER_FORMAT;
    if (*str == '\0') return STATUS_ERR_NUMBER_FORMAT;

    const char *p = str;
    int negative = 0;
    if (*p == '+' || *p == '-') { negative = (*p == '-'); ++p; }
    if (*p == '\0') return STATUS_ERR_NUMBER_FORMAT;
    for (const char *q = p; *q; ++q) {
        if (!isdigit((unsigned char)*q)) return STATUS_ERR_NUMBER_FORMAT;
    }
    const long max_div = LONG_MAX / 10;
    const int  max_mod = (int)(LONG_MAX % 10);

    long val = 0;
    for (; *p; ++p) {
        int d = *p - '0';

        if (negative) {
            if (val > max_div ||
                (val == max_div && d > max_mod + 1))
                return STATUS_ERR_NUMBER_FORMAT;
        } else {
            if (val > max_div ||
                (val == max_div && d > max_mod))
                return STATUS_ERR_NUMBER_FORMAT;
        }

        val = val * 10 + d;
    }

    if (negative) {
        if (val == LONG_MAX) {
            return STATUS_ERR_NUMBER_FORMAT;
        }
        *out = -val;
    } else {
        *out = val;
    }
    return STATUS_OK;
}

static void fill_random_long(long *arr, size_t n, long a, long b) {
    long range = b - a + 1;
    for (size_t i = 0; i < n; ++i) arr[i] = a + rand() % range;
}

static void swap_min_max(long *arr, size_t n) {
    if (arr == NULL || n < 2) return;
    size_t i_min = 0, i_max = 0;
    for (size_t i = 1; i < n; ++i) {
        if (arr[i] < arr[i_min]) i_min = i;
        if (arr[i] > arr[i_max]) i_max = i;
    }
    long tmp = arr[i_min];
    arr[i_min] = arr[i_max];
    arr[i_max] = tmp;
}

static void print_long_array(const long *arr, size_t n) {
    for (size_t i = 0; i < n; ++i) {
        printf("%ld", arr[i]);
        if (i + 1 < n) printf(" ");
    }
    printf("\n");
}

static enum Status staticArray(int argc, char *argv[]) {
    if (argc != 3) {
        fprintf(stderr, "Задача 1: %s <a> <b>\n", argv[0]);
        return STATUS_ERR_ARGC;
    }
    long a, b;
    if (parse_long(argv[1], &a) != STATUS_OK) {
        fprintf(stderr, "Ошибка: неверное a.\n");
        return STATUS_ERR_NUMBER_FORMAT;
    }
    if (parse_long(argv[2], &b) != STATUS_OK) {
        fprintf(stderr, "Ошибка: неверное b.\n");
        return STATUS_ERR_NUMBER_FORMAT;
    }
    if (a > b) { fprintf(stderr, "a > b.\n"); return STATUS_ERR_RANGE; }

    long arr[ARR_SIZE];
    fill_random_long(arr, ARR_SIZE, a, b);

    printf("Задача 1: исходный массив:\n  ");
    print_long_array(arr, ARR_SIZE);

    swap_min_max(arr, ARR_SIZE);

    printf("После обмена min/max:\n  ");
    print_long_array(arr, ARR_SIZE);
    return STATUS_OK;
}

static void fill_random_int(int *arr, size_t n, int lo, int hi) {
    int range = hi - lo + 1;
    for (size_t i = 0; i < n; ++i) arr[i] = lo + rand() % range;
}

static int cmp_int(const void *a, const void *b) {
    int x = *(const int *)a;
    int y = *(const int *)b;
    return (x > y) - (x < y);
}

static size_t closest_in_sorted(const int *arr, size_t n, int key) {
    size_t lo = 0, hi = n - 1;
    while (lo < hi) {
        size_t mid = (lo + hi) / 2;
        if (arr[mid] < key) lo = mid + 1;
        else hi = mid;
    }
    size_t best = lo;
    if (lo > 0) {
        long d1 = labs((long)arr[lo] - key);
        long d2 = labs((long)arr[lo - 1] - key);
        if (d2 <= d1) best = lo - 1;
    }
    return best;
}

static enum Status dynamicArray(void) {
    size_t n = MIN_SIZE + (size_t)(rand() % (MAX_SIZE - MIN_SIZE + 1));
    size_t m = MIN_SIZE + (size_t)(rand() % (MAX_SIZE - MIN_SIZE + 1));

    printf("\nЗадача 2: размер A = %zu, размер B = %zu\n", n, m);

    int *A = malloc(n * sizeof(int));
    int *B = malloc(m * sizeof(int));
    int *C = malloc(n * sizeof(int));
    if (!A || !B || !C) {
        fprintf(stderr, "Ошибка памяти.\n");
        free(A); free(B); free(C);
        return STATUS_ERR_MEMORY;
    }

    fill_random_int(A, n, MIN_VAL, MAX_VAL);
    fill_random_int(B, m, MIN_VAL, MAX_VAL);
    qsort(B, m, sizeof(int), cmp_int);

    for (size_t i = 0; i < n; ++i) {
        size_t j = closest_in_sorted(B, m, A[i]);
        C[i] = A[i] + B[j];
    }

    printf("Первые 10 элементов:\n");
    printf("  A: ");
    for (size_t i = 0; i < n && i < 10; ++i) printf("%5d ", A[i]);
    printf("\n  B: ");
    for (size_t i = 0; i < m && i < 10; ++i) printf("%5d ", B[i]);
    printf("\n  C: ");
    for (size_t i = 0; i < n && i < 10; ++i) printf("%5d ", C[i]);
    printf("\n");

    free(A); free(B); free(C);
    return STATUS_OK;
}

int main(int argc, char *argv[]) {
    srand((unsigned)time(NULL));

    enum Status st = staticArray(argc, argv);
    if (st != STATUS_OK) return st;

    st = dynamicArray();
    return st;
}
